{
  "name": "rahatlink",
  "version": "0.1.0",
  "private": true,
  "description": "RahatLink: Offline-first neighbourhood safety & proactive silence detection",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@rahatlink/web",
    "dev:hub": "npm run dev --workspace=@rahatlink/hub",
    "dev": "concurrently -k -n \"web,hub\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:hub\"",
    "test": "npm run test --workspace=@rahatlink/core",
    "sim:score": "tsx scripts/scoreSim.ts",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "pako": "^3.0.2",
    "qrcode": "^1.5.4"
  }
}
